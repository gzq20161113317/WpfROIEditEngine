<UserControl x:Class="RoiEditor.Views.Component.Setting.SelectSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:local="clr-namespace:RoiEditor.Views.Component.Setting"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="300">
    <StackPanel Margin="10">

        <GroupBox Header="Properties" Foreground="Gray" BorderBrush="#444" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <TextBlock Text="Line Width (px):" Foreground="#CCC" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding TargetLineWidth}" Background="#333" Foreground="White" BorderThickness="0" Padding="5"/>
                    <Button Grid.Column="1" Content="Apply All" 
                            cal:Message.Attach="ApplyLineWidth"
                            Background="#007ACC" Foreground="White" BorderThickness="0" Padding="10,0" Margin="5,0,0,0" Cursor="Hand"/>
                </Grid>
                <TextBlock Text="(Applies to ALL regions in active ROI)" Foreground="#666" FontSize="10" Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Move Selected" Foreground="Gray" BorderBrush="#444" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <DockPanel LastChildFill="False" Margin="0,0,0,5">
                    <TextBlock Text="Step (px):" Foreground="#CCC" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MoveStep}" Width="60" Background="#333" Foreground="White" BorderThickness="0" Padding="3" DockPanel.Dock="Right"/>
                </DockPanel>

                <Grid HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="1" Content="▲" 
                            cal:Message.Attach="Move('Up')"
                            Background="#444" Foreground="White" BorderThickness="0"/>

                    <Button Grid.Row="1" Grid.Column="0" Content="◀" 
                            cal:Message.Attach="Move('Left')"
                            Background="#444" Foreground="White" BorderThickness="0"/>

                    <Button Grid.Row="1" Grid.Column="2" Content="▶" 
                            cal:Message.Attach="Move('Right')"
                            Background="#444" Foreground="White" BorderThickness="0"/>

                    <Button Grid.Row="2" Grid.Column="1" Content="▼" 
                            cal:Message.Attach="Move('Down')"
                            Background="#444" Foreground="White" BorderThickness="0"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Inflate / Erode" Foreground="Gray" BorderBrush="#444">
            <StackPanel Margin="5">
                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock Text="Amount (px):" Foreground="#CCC" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding InflateAmount}" Width="60" Background="#333" Foreground="White" BorderThickness="0" Padding="3" DockPanel.Dock="Right"/>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Expand (+)" 
                            cal:Message.Attach="Inflate('true')"
                            Background="#333" Foreground="White" BorderThickness="0" Height="30"/>

                    <Button Grid.Column="2" Content="Shrink (-)" 
                            cal:Message.Attach="Inflate('false')"
                            Background="#333" Foreground="White" BorderThickness="0" Height="30"/>
                </Grid>
            </StackPanel>
        </GroupBox>

    </StackPanel>
</UserControl>
