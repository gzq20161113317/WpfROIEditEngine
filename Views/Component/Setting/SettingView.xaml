<UserControl x:Class="RoiEditor.Views.Component.Setting.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RoiEditor.Views.Component.Setting"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="300">
    <Border Background="#252526"
            BorderBrush="#444"
            BorderThickness="1,0,0,0"
            Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border BorderThickness="0,0,0,1" Background="#252526" BorderBrush="#3F3F46">
                <TextBlock Text="Setting" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
            </Border>
            <ScrollViewer Grid.Row="1" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" Padding="5"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ContentControl  x:Name="ActiveItem"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
