<UserControl x:Class="RoiEditor.Views.RoiMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RoiEditor.Views"
             xmlns:vm="clr-namespace:RoiEditor.ViewModels"
             xmlns:controls="clr-namespace:RoiEditor.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:RoiMainViewModel,IsDesignTimeCreatable=True}"
             d:DesignHeight="1024" d:DesignWidth="1920">
    <Grid Background="#2D2D30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
            <!-- 右侧面板宽度你可调：320/360/420 -->
        </Grid.ColumnDefinitions>

        <!-- ===================== Left Column ===================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- ToolBar -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <!-- Canvas -->
            </Grid.RowDefinitions>

            <!-- ToolBar (Row 0) -->
            <Border Grid.Row="0"
                    Background="#333"
                    BorderBrush="#444"
                    BorderThickness="0,0,0,1"
                    Padding="8">
                <DockPanel LastChildFill="False">
                    <!-- 左侧按钮区 -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="SetPanMode" Width="90" Height="36" Margin="0,0,8,0" ToolTip="平移 (Pan)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✋" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Pan" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SetSelectMode" Width="90" Height="36" Margin="0,0,8,0" ToolTip="选择 (Select)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↖" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Select" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SetDrawRectMode" Width="90" Height="36" ToolTip="画矩形 (Draw Rect)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬜" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Rect" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FitToCoarsest" Width="120" Height="36" Margin="8,0,0,0" ToolTip="最低清层居中">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌖" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Fit Low" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 右侧状态区 -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="MODE:" Foreground="Gray" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CurrentMode}" Foreground="Cyan" FontWeight="Bold" Margin="0,0,14,0"/>

                        <TextBlock Text="{Binding RoiList.Count, StringFormat='ROIs: {0}'}" Foreground="White" FontSize="11" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- RoiEditorCanvas (Row 1) -->
            <controls:RoiEditorCanvas Grid.Row="1"
                                      ItemsSource="{Binding RoiList}"
                                      Mode="{Binding CurrentMode}"
                                      MapPath="{Binding MapPath}"
                                      MaxLevel="{Binding MaxLevel, Mode=OneWayToSource}" 
                                      CurrentLevel="{Binding CurrentLevel, Mode=OneWayToSource}"
                                      EventAggregator="{Binding EventAggregator}"
                                      SelectedRoi="{Binding SelectedRoi, Mode=TwoWay}"
                                      Background="#1E1E1E"/>
            <StatusBar Grid.Row="2">
                <StatusBarItem>
                    <TextBlock Text="{Binding LevelStatusString}" FontWeight="Bold"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>

        <!-- ===================== Right Column ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*"/>
                <!-- RoiList -->
                <RowDefinition Height="5*"/>
                <!-- Details / Parameters -->
            </Grid.RowDefinitions>

            <!-- RoiList (Row 0) -->
            <Border Grid.Row="0"
                    Background="#252526"
                    BorderBrush="#444"
                    BorderThickness="1,0,0,1"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ROI LIST" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>

                    <!-- 你可以用 ListBox / DataGrid / ListView，这里用 ListBox 最简单 -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding RoiList}"
                             SelectedItem="{Binding SelectedRoi, Mode=TwoWay}"
                             Background="#1E1E1E"
                             BorderBrush="#3F3F46"
                             Foreground="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Type}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Details / Parameters (Row 1) -->
            <Border Grid.Row="1"
                    Background="#252526"
                    BorderBrush="#444"
                    BorderThickness="1,0,0,0"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="DETAILS / PARAMETERS" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>

                    <!-- 先放一个占位：后续你可以换成 TabControl / PropertyGrid / 参数表单等 -->
                    <Border Grid.Row="1"
                            Background="#1E1E1E"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRoi.Name, StringFormat='Selected: {0}'}"
                                       Foreground="White" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="（这里后续放 ROI/Region 参数、测量结果、属性编辑等）"
                                       Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
