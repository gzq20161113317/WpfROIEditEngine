<UserControl x:Class="RoiEditor.Views.RoiMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RoiEditor.Views"
             xmlns:vm="clr-namespace:RoiEditor.ViewModels"
             xmlns:controls="clr-namespace:RoiEditor.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:RoiMainViewModel,IsDesignTimeCreatable=True}"
             d:DesignHeight="1024" d:DesignWidth="1920">
    <Grid Background="#2D2D30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
            <!-- 右侧面板宽度你可调：320/360/420 -->
        </Grid.ColumnDefinitions>

        <!-- ===================== Left Column ===================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- ToolBar -->
                <RowDefinition Height="*"/>
                <!-- Canvas -->
            </Grid.RowDefinitions>

            <!-- ToolBar (Row 0) -->
            <ContentControl x:Name="ToolBar" Grid.Row="0" />

            <!-- RoiEditorCanvas (Row 1) -->
            <ContentControl x:Name="Canvas" Grid.Row="1" />
        </Grid>

        <!-- ===================== Right Column ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*"/>
                <!-- RoiList -->
                <RowDefinition Height="5*"/>
                <!-- Details / Parameters -->
            </Grid.RowDefinitions>

            <!-- RoiList (Row 0) -->
            <Border Grid.Row="0"
                    Background="#252526"
                    BorderBrush="#444"
                    BorderThickness="1,0,0,1"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ROI LIST" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>

                    <!-- 你可以用 ListBox / DataGrid / ListView，这里用 ListBox 最简单 -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ROIRegionList}"
                             SelectedItem="{Binding SelectedROIRegion, Mode=TwoWay}"
                             Background="#1E1E1E"
                             BorderBrush="#3F3F46"
                             Foreground="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Type}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Details / Parameters (Row 1) -->
            <Border Grid.Row="1"
                    Background="#252526"
                    BorderBrush="#444"
                    BorderThickness="1,0,0,0"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="DETAILS / PARAMETERS" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>

                    <!-- 先放一个占位：后续你可以换成 TabControl / PropertyGrid / 参数表单等 -->
                    <Border Grid.Row="1"
                            Background="#1E1E1E"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedROIRegion.Name, StringFormat='Selected: {0}'}"
                                       Foreground="White" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="（这里后续放 ROI/Region 参数、测量结果、属性编辑等）"
                                       Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
