<Window x:Class="SelectRoiWindows.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SelectRoiWindows.Views"
        mc:Ignorable="d"
       Title="Shell" 
        Height="840"
        Width="1240"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#F0F0F0" Padding="5">
            <MenuItem Header="_File">
                <MenuItem Header="Load Map Folder..." x:Name="LoadMap"/>
                <Separator/>
                <MenuItem Header="E_xit" x:Name="Exit"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="About"/>
            </MenuItem>
        </Menu>

        <ContentControl x:Name="RoiEditorView" Grid.Row="1"/>

        <StatusBar Grid.Row="2" Background="#007ACC" Foreground="White">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Margin="5,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
