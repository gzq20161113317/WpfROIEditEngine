<UserControl x:Class="RoiEditor.Controls.RoiEditorCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RoiEditor.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             ClipToBounds="True" Background="#111">
    <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="False">
        <!-- World Space：跟随地图缩放/平移 -->
        <Grid x:Name="WorldContainer" RenderTransformOrigin="0,0" IsHitTestVisible="False">
            <Grid.RenderTransform>
                <MatrixTransform x:Name="MainMatrix"/>
            </Grid.RenderTransform>

            <!-- 单层瓦片画布 -->
            <Canvas x:Name="MapCanvas" IsHitTestVisible="False"/>

            <!-- 未选中的 ROI（World Space） -->
            <Canvas x:Name="StaticLayer" IsHitTestVisible="False"/>
        </Grid>

        <!-- Screen Space：选中 ROI（虚线像素一致） -->
        <Canvas x:Name="EditorLayer" IsHitTestVisible="False"/>

        <!-- Cursor Space -->
        <Canvas x:Name="CursorLayer" IsHitTestVisible="False">

            <ContentControl x:Name="CursorContainer" Visibility="Collapsed">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="CursorTransform"/>
                </ContentControl.RenderTransform>
            </ContentControl>

        </Canvas>

        <TextBlock Text="{Binding ElementName=MainMatrix, Path=Matrix.M11, StringFormat='Zoom: {0:F2}x'}"
                   Foreground="Lime"
                   Margin="6"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Right"
                   IsHitTestVisible="False"/>
    </Grid>
</UserControl>
